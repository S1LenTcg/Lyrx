<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Musebase.Android</RootNamespace>
    <AssemblyName>Lyrx.Android</AssemblyName>
    <ApplicationId>app.lyrx.android</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
    <ApplicationTitle>Lyrx</ApplicationTitle>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidStoreUncompressedFileExtensions>$(AndroidStoreUncompressedFileExtensions);.ttf;.otf</AndroidStoreUncompressedFileExtensions>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <!-- 仅输出真机 arm64-v8a 架构，并关闭 AOT 以显著缩小正式包体积 -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lyrx.Core\Lyrx.Core.csproj" />
    <ProjectReference Include="..\..\src\Lyrx.Engine\Lyrx.Engine.csproj" />
  </ItemGroup>

  <Target Name="_ExportVersionedSignedApk"
          AfterTargets="_Sign;SignAndroidPackage"
          Condition=" '$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'True' And Exists('$(ApkFileSigned)') ">
    <PropertyGroup>
      <_VersionedSignedApk>$(OutDir)$(ApplicationTitle) V$(ApplicationDisplayVersion).apk</_VersionedSignedApk>
    </PropertyGroup>
    <Copy SourceFiles="$(ApkFileSigned)" DestinationFiles="$(_VersionedSignedApk)" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(ApkFile)" Condition=" Exists('$(ApkFile)') " />
    <Message Importance="High" Text="[Lyrx.Android] Signed APK: $(_VersionedSignedApk)" />
  </Target>

</Project>
